# Copie para .env e preencha. O .env NUNCA vai para o git.
# No Railway, defina estas variaveis no painel do servico.

# ---------------------------------------------------------------------------
# Acesso a aplicacao
# ---------------------------------------------------------------------------
# Obrigatorios quando AMBIENTE=producao. Sem eles a aplicacao recusa subir.
APP_USUARIO=
APP_SENHA=

# Chave usada para assinar o cookie de sessao. Gere uma string longa e
# aleatoria. Se ficar vazia, uma nova e sorteada a cada reinicio e todo mundo
# cai da sessao quando o servico reinicia.
APP_CHAVE_SESSAO=

# local | producao
AMBIENTE=local

# ---------------------------------------------------------------------------
# Planilhas
# ---------------------------------------------------------------------------
# Pasta onde estao os cinco arquivos .xlsx do escritorio.
# Local: pode deixar vazio, a aplicacao acha a pasta do OneDrive sozinha.
# Railway: sistema de arquivos e efemero, entao aponte para um volume
# persistente montado no servico. Ver README, secao Deploy.
PASTA_PLANILHAS=

# ---------------------------------------------------------------------------
# Modelo de linguagem
# ---------------------------------------------------------------------------
# auto      = usa a Anthropic quando houver chave, senao cai no interpretador local
# anthropic = exige a chave, falha alto se nao houver
# regras    = so o interpretador local, sem rede
LLM_PROVEDOR=auto

# Chave da API. Sem isso, LLM_PROVEDOR=auto usa o interpretador por regras
# e a aplicacao continua respondendo.
ANTHROPIC_API_KEY=

# Modelo a usar. Padrao: claude-sonnet-4-5
LLM_MODELO=

# ---------------------------------------------------------------------------
# Integracoes futuras (Fase 5) - NAO usar ainda
# ---------------------------------------------------------------------------
# Nenhuma destas e lida pelo codigo hoje. Estao aqui so para registrar que,
# quando existirem, entram por variavel de ambiente e nunca no repositorio.
# OMIE_APP_KEY=
# OMIE_APP_SECRET=
# XJUS_TOKEN=
