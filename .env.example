# Copie para .env e preencha. O .env NUNCA vai para o git.
# No Railway, defina no painel do servico.

# ---------------------------------------------------------------------------
# AS TRES QUE VOCE PRECISA DEFINIR NO RAILWAY
# ---------------------------------------------------------------------------

# Usuario e senha de acesso. Sem eles o app RECUSA subir em producao, para
# nao deixar o financeiro do escritorio aberto na internet.
APP_USUARIO=
APP_SENHA=

# Chave da API do modelo, em console.anthropic.com. Sem ela o app funciona,
# mas usando o interpretador local por palavra-chave, que nao entende
# pergunta de continuidade nem frase livre.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# O RESTO O APP DESCOBRE SOZINHO - so mexa se precisar sair do padrao
# ---------------------------------------------------------------------------

# local | producao
# No Railway o padrao ja e producao, que exige login.
# AMBIENTE=

# Pasta das planilhas. No Railway o padrao ja e /data, onde o volume e
# montado. Localmente, acha a pasta do OneDrive sozinho.
# PASTA_PLANILHAS=

# Assina o cookie de sessao. Se nao definir, o app gera uma e guarda no
# volume, entao a sessao sobrevive a reinicio sem voce fazer nada.
# APP_CHAVE_SESSAO=

# auto      = usa a Anthropic quando houver chave, senao cai no local
# anthropic = exige a chave, falha alto se nao houver
# regras    = so o interpretador local, sem rede
# LLM_PROVEDOR=auto

# Modelo a usar. Padrao: claude-sonnet-4-5
# LLM_MODELO=

# ---------------------------------------------------------------------------
# Integracoes futuras - NAO usar ainda
# ---------------------------------------------------------------------------
# Nenhuma e lida pelo codigo hoje. Estao aqui so para registrar que, quando
# existirem, entram por variavel de ambiente e nunca no repositorio.
# OMIE_APP_KEY=
# OMIE_APP_SECRET=
# XJUS_TOKEN=
